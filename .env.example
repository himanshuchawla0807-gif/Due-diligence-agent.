APP_NAME=Due Diligence Agent Open
APP_ENV=development
HOST=0.0.0.0
PORT=8102
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
FRONTEND_URL=http://localhost:5174

DUE_DILIGENCE_PROVIDER=mock
DUE_DILIGENCE_MODEL=mock-diligence
DUE_DILIGENCE_RISK_MODEL=mock-risk-reviewer

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
SESSION_STORE=./storage/sessions.json
MAX_UPLOAD_MB=100
RAG_STORAGE_DIR=./storage/rag
DEFAULT_RAG_SOURCE_DIR=
LOCAL_EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_WORDS=420
RAG_CHUNK_OVERLAP_WORDS=80
RAG_TOP_K=12
RAG_REPORT_TOP_K=64
RAG_FILE_QUERY_LIMIT=60
DUE_DILIGENCE_MULTI_PASS=true
DUE_DILIGENCE_DOMAIN_TOP_K=18
DUE_DILIGENCE_MAX_FINDINGS=80
